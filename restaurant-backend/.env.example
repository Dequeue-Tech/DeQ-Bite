NODE_ENV=development
PORT=5000

# Frontend URL
FRONTEND_URL=http://localhost:3000
BASE_DOMAIN=example.com

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/restaurant_db"

# Redis (BullMQ order-completion worker — use REDIS_URL OR host/port)
# Order completion jobs are queued when REDIS_URL or REDIS_HOST is set; otherwise the API falls back to in-process delivery (not ideal on serverless).
# REDIS_URL=redis://default:password@your-redis.upstash.io:6379
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Backblaze B2 Cloud Storage Configuration
# Firebase Admin SDK (required for API auth verification)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Keep newline escapes in one line (\\n) when using .env files
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\nYOUR_PRIVATE_KEY_HERE\\n-----END PRIVATE KEY-----\\n"

# Legacy JWT (deprecated, kept for backward compatibility only)
JWT_SECRET=deprecated-not-used
JWT_EXPIRES_IN=7d

# Razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Paytm (optional)
PAYTM_MERCHANT_ID=
PAYTM_MERCHANT_KEY=

# PhonePe (optional)
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=

# Email Configuration
# Works with Gmail SMTP, Brevo SMTP, and other SMTP providers.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password


# Fast2SMS configuration
# Route "q" is Fast2SMS Quick SMS and, per their docs, costs INR 5/SMS.
# FAST2SMS uses 10-digit Indian mobile numbers; +91 numbers are converted automatically.
# SMS_PROVIDER=fast2sms
# FAST2SMS_API_KEY=your_fast2sms_api_key
# FAST2SMS_ROUTE=q
# FAST2SMS_LANGUAGE=english
# FAST2SMS_API_URL=https://www.fast2sms.com/dev/bulkV2

# Twilio SMS configuration
# Set SMS_PROVIDER=twilio to route SMS through Twilio.
# TWILIO_PHONE_NUMBER or TWILIO_MESSAGING_SERVICE_SID is required.
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=+1234567890
# TWILIO_MESSAGING_SERVICE_SID=MGXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# App Configuration
APP_NAME=Restaurant Online Ordering
APP_URL=http://localhost:5000

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./public/uploads

# Backblaze B2 Cloud Storage Configuration
# Get these from your B2 account: https://secure.backblaze.com/b2_buckets.htm
B2_APPLICATION_KEY_ID=your_b2_application_key_id
B2_APPLICATION_KEY=your_b2_application_key
B2_BUCKET_ID=your_b2_bucket_id
B2_BUCKET_NAME=your-bucket-name
# Optional: Custom domain for public URLs (e.g., https://cdn.yourdomain.com)
# If not set, will use B2's native public URL format
# B2_CUSTOM_DOMAIN=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security
ENCRYPTION_KEY=your-32-character-encryption-key-here
API_KEY=your-api-key-for-internal-services
