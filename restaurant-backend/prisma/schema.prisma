generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  phone           String?          @unique
  name            String
  password        String
  role            UserRole         @default(CUSTOMER)
  verified        Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  orders          Order[]
  restaurantUsers RestaurantUser[]
  customerProfiles CustomerProfile[]

  @@map("users")
}

model Restaurant {
  id                      String                  @id @default(cuid())
  name                    String
  slug                    String                  @unique
  subdomain               String                  @unique
  status                  OnboardingStatus        @default(PENDING_APPROVAL)
  suspendedReason         String?
  email                   String?
  phone                   String?
  address                 String?
  city                    String?
  state                   String?
  country                 String?
  cuisine                 String?
  cuisineTypes            String[]                @default([])
  logoUrl                 String?
  bannerUrl               String?
  googleReviewUrl         String?
  gstNumber               String?
  gstLegalName            String?
  bankAccountName         String?
  bankAccountNumber       String?
  bankIfsc                String?
  bankName                String?
  commissionRate          Int                     @default(0)
  commissionRateBps       Int                     @default(0)
  approvedAt              DateTime?
  approvedByUserId        String?
  onboardingStatus        OnboardingStatus        @default(PENDING_APPROVAL)
  active                  Boolean                 @default(true)
  paymentCollectionTiming PaymentCollectionTiming @default(AFTER_MEAL)
  cashPaymentEnabled      Boolean                 @default(true)
  acceptedPaymentMethods  String[]
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  categories              Category[]
  coupons                 Coupon[]
  popularDishes           PopularDish[]
  menuItems               MenuItem[]
  offers                  Offer[]
  orders                  Order[]
  users                   RestaurantUser[]
  tables                  Table[]
  earnings                Earning[]              @relation("earnings")
  rawMaterials            RawMaterial[]
  menuItemRecipes         MenuItemRecipe[]
  inventoryTransactions   InventoryTransaction[]
  inventoryAlerts         InventoryAlert[]
  purchaseOrders          PurchaseOrder[]
  customerProfiles        CustomerProfile[]
  loyaltyLedgerEntries    LoyaltyLedger[]
  couponRedemptions       CouponRedemption[]
  kotTickets              KOTTicket[]
  kotTicketEvents         KOTTicketEvent[]
  analyticsSnapshots      AnalyticsSnapshot[]
  posSyncLogs             PosSyncLog[]

  @@map("restaurants")
}

model RestaurantUser {
  id           String         @id @default(cuid())
  restaurantId String
  userId       String
  role         RestaurantRole @default(ADMIN)
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  restaurant   Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, userId])
  @@index([restaurantId, userId, active])
  @@map("restaurant_users")
}

model Category {
  id           String     @id @default(cuid())
  name         String
  description  String?
  image        String?
  active       Boolean    @default(true)
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItems    MenuItem[]

  @@unique([restaurantId, name])
  @@index([restaurantId, active, sortOrder])
  @@map("categories")
}

model MenuItem {
  id              String      @id @default(cuid())
  name            String
  description     String?
  image           String?
  categoryId      String
  available       Boolean     @default(true)
  preparationTime Int         @default(15)
  ingredients     String[]    @default([])
  allergens       String[]    @default([])
  isVeg           Boolean     @default(true)
  isVegan         Boolean     @default(false)
  isGlutenFree    Boolean     @default(false)
  spiceLevel      SpiceLevel  @default(MILD)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  pricePaise      Int
  restaurantId    String
  category        Category    @relation(fields: [categoryId], references: [id])
  restaurant      Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orderItems      OrderItem[]
  popularDishes   PopularDish[]
  recipes         MenuItemRecipe[]

  @@map("menu_items")
  @@index([restaurantId, available])
  @@index([restaurantId, categoryId])
}

model PopularDish {
  id           String     @id @default(cuid())
  restaurantId String
  menuItemId   String
  rank         Int        @default(0)
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItem     MenuItem  @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, menuItemId])
  @@map("popular_dishes")
}

model Table {
  id           String     @id @default(cuid())
  number       Int
  capacity     Int
  location     String?
  active       Boolean    @default(true)
  restaurantId String
  orders       Order[]
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, number])
  @@index([restaurantId, active])
  @@map("tables")
}

model Order {
  id                      String                  @id @default(cuid())
  userId                  String
  tableId                 String
  status                  OrderStatus             @default(PENDING)
  isDelivery              Boolean                 @default(false)
  deliveryStatus          DeliveryStatus?
  deliveryCustomerName    String?
  deliveryCustomerPhone   String?
  deliveryAddress         String?
  deliveryLandmark        String?
  deliveryRiderName       String?
  deliveryRiderPhone      String?
  deliveryApprovedAt      DateTime?
  paymentId               String?
  paymentStatus           PaymentStatus           @default(PENDING)
  specialInstructions     String?
  estimatedTime           Int?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  couponId                String?
  discountPaise           Int                     @default(0)
  paymentCollectionTiming PaymentCollectionTiming @default(AFTER_MEAL)
  paymentProvider         PaymentProvider         @default(RAZORPAY)
  paymentTransactionId    String?
  paidAmountPaise         Int                     @default(0)
  dueAmountPaise          Int                     @default(0)
  restaurantId            String
  subtotalPaise           Int
  taxPaise                Int
  totalPaise              Int
  invoice                 Invoice?
  items                   OrderItem[]
  coupon                  Coupon?                 @relation(fields: [couponId], references: [id])
  restaurant              Restaurant              @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table                   Table                   @relation(fields: [tableId], references: [id])
  user                    User                    @relation(fields: [userId], references: [id])
  payments                Payment[]
  kotTicket               KOTTicket?
  inventoryTransactions   InventoryTransaction[]
  couponRedemptions       CouponRedemption[]
  loyaltyLedgerEntries    LoyaltyLedger[]

  @@map("orders")
  @@index([restaurantId, createdAt])
  @@index([restaurantId, userId, createdAt])
  @@index([restaurantId, status, createdAt])
  @@index([restaurantId, paymentStatus, createdAt])
  @@index([restaurantId, isDelivery, deliveryStatus, createdAt])
  @@index([restaurantId, userId, isDelivery, createdAt])
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  menuItemId String
  quantity   Int
  notes      String?
  pricePaise Int
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

model Invoice {
  id            String          @id @default(cuid())
  orderId       String          @unique
  invoiceNumber String          @unique
  issuedAt      DateTime        @default(now())
  sentVia       InvoiceMethod[]
  emailSent     Boolean         @default(false)
  smsSent       Boolean         @default(false)
  pdfPath       String?
  pdfData       Bytes?
  pdfName       String?
  order         Order           @relation(fields: [orderId], references: [id])

  @@map("invoices")
  @@index([issuedAt])
}

model Coupon {
  id               String     @id @default(cuid())
  code             String
  description      String?
  type             CouponType
  value            Int
  maxDiscountPaise Int?
  minOrderPaise    Int?
  usageLimit       Int?
  usageCount       Int        @default(0)
  startsAt         DateTime?
  endsAt           DateTime?
  active           Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  restaurantId     String
  restaurant       Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders           Order[]
  redemptions      CouponRedemption[]

  @@unique([restaurantId, code])
  @@map("coupons")
}

model Offer {
  id                   String     @id @default(cuid())
  restaurantId         String
  title                String?
  name                 String?
  code                 String?
  description          String?
  type                 OfferType?
  discountType         String?
  value                Float
  minimumOrderValue    Int?
  minOrderPaise        Int?
  maximumDiscount      Int?
  maxDiscountPaise     Int?
  startDate            DateTime?
  startsAt             DateTime?
  endDate              DateTime?
  endsAt               DateTime?
  maxUses              Int?
  currentUses          Int        @default(0)
  isActive             Boolean    @default(true)
  active               Boolean    @default(true)
  applicableItems      String[]   @default([])
  applicableCategories String[]   @default([])
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  restaurant           Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("offers")
  @@index([restaurantId, active])
  @@index([restaurantId, startsAt, endsAt])
}

model Payment {
  id                String       @id @default(cuid())
  orderId           String
  userId            String
  restaurantId      String
  method            String
  provider          String
  amountPaise       Int
  status            PaymentStatus
  providerOrderId   String?
  providerPaymentId String?
  providerSignature String?
  notes             String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  order             Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
  @@index([orderId])
  @@index([restaurantId, createdAt])
}

model Earning {
  id                      String     @id @default(cuid())
  restaurantId            String
  orderId                 String     @unique
  grossAmountPaise        Int
  platformCommissionPaise Int
  restaurantEarningPaise  Int
  settled                 Boolean    @default(false)
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt
  restaurant              Restaurant @relation("earnings", fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("earnings")
}

model AuditLog {
  id            String   @id @default(cuid())
  actorUserId   String
  restaurantId  String?
  action        String
  entityType    String
  entityId      String?
  metadata      Json?
  createdAt     DateTime @default(now())

  @@map("audit_logs")
}

model RawMaterial {
  id                    String                 @id @default(cuid())
  restaurantId          String
  name                  String
  sku                   String?
  unit                  String
  currentStock          Float                  @default(0)
  reorderLevel          Float                  @default(0)
  costPerUnitPaise      Int                    @default(0)
  active                Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  restaurant            Restaurant             @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  recipeMappings        MenuItemRecipe[]
  transactions          InventoryTransaction[]
  alerts                InventoryAlert[]
  purchaseOrderItems    PurchaseOrderItem[]

  @@unique([restaurantId, name])
  @@index([restaurantId, active, currentStock])
  @@map("raw_materials")
}

model MenuItemRecipe {
  id             String      @id @default(cuid())
  restaurantId   String
  menuItemId     String
  rawMaterialId  String
  quantity       Float
  wasteFactorPct Float       @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  restaurant     Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItem       MenuItem    @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  rawMaterial    RawMaterial @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, rawMaterialId])
  @@index([restaurantId, menuItemId])
  @@map("menu_item_recipes")
}

model InventoryTransaction {
  id               String                    @id @default(cuid())
  restaurantId     String
  rawMaterialId    String
  orderId          String?
  type             InventoryTransactionType
  referenceType    InventoryReferenceType
  referenceId      String?
  quantityDelta    Float
  stockBefore      Float
  stockAfter       Float
  unitCostPaise    Int?
  totalCostPaise   Int?
  notes            String?
  createdAt        DateTime                  @default(now())
  createdByUserId  String?
  restaurant       Restaurant                @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  rawMaterial      RawMaterial               @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)
  order            Order?                    @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([restaurantId, createdAt])
  @@index([restaurantId, rawMaterialId, createdAt])
  @@map("inventory_transactions")
}

model InventoryAlert {
  id                 String      @id @default(cuid())
  restaurantId       String
  rawMaterialId      String
  type               String
  thresholdValue     Float?
  currentValue       Float
  acknowledged       Boolean     @default(false)
  acknowledgedAt     DateTime?
  acknowledgedByUserId String?
  createdAt          DateTime    @default(now())
  restaurant         Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  rawMaterial        RawMaterial @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)

  @@index([restaurantId, acknowledged, createdAt])
  @@map("inventory_alerts")
}

model PurchaseOrder {
  id                   String               @id @default(cuid())
  restaurantId         String
  vendorName           String
  status               PurchaseOrderStatus  @default(DRAFT)
  notes                String?
  expectedDeliveryAt   DateTime?
  receivedAt           DateTime?
  totalCostPaise       Int                  @default(0)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  createdByUserId      String?
  restaurant           Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items                PurchaseOrderItem[]

  @@index([restaurantId, status, createdAt])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id                 String        @id @default(cuid())
  purchaseOrderId    String
  rawMaterialId      String
  quantityOrdered    Float
  quantityReceived   Float         @default(0)
  unitCostPaise      Int
  purchaseOrder      PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  rawMaterial        RawMaterial   @relation(fields: [rawMaterialId], references: [id], onDelete: Restrict)

  @@unique([purchaseOrderId, rawMaterialId])
  @@map("purchase_order_items")
}

model CustomerProfile {
  id              String          @id @default(cuid())
  restaurantId    String
  userId          String
  loyaltyPoints   Int             @default(0)
  totalOrders     Int             @default(0)
  totalSpendPaise Int             @default(0)
  lastOrderAt     DateTime?
  tier            String          @default("BRONZE")
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  restaurant      Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  loyaltyLedger   LoyaltyLedger[]
  couponRedemptions CouponRedemption[]

  @@unique([restaurantId, userId])
  @@index([restaurantId, loyaltyPoints])
  @@map("customer_profiles")
}

model LoyaltyLedger {
  id                 String                  @id @default(cuid())
  restaurantId       String
  customerProfileId  String
  orderId            String?
  points             Int
  type               LoyaltyTransactionType
  reason             String?
  createdAt          DateTime                @default(now())
  createdByUserId    String?
  restaurant         Restaurant              @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customerProfile    CustomerProfile         @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  order              Order?                  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([restaurantId, customerProfileId, createdAt])
  @@map("loyalty_ledger")
}

model CouponRedemption {
  id                 String          @id @default(cuid())
  restaurantId       String
  customerProfileId  String
  orderId            String?
  couponId           String?
  couponCode         String
  discountPaise      Int             @default(0)
  redeemedAt         DateTime        @default(now())
  restaurant         Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customerProfile    CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  order              Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  coupon             Coupon?         @relation(fields: [couponId], references: [id], onDelete: SetNull)

  @@index([restaurantId, redeemedAt])
  @@map("coupon_redemptions")
}

model KOTTicket {
  id                String      @id @default(cuid())
  restaurantId      String
  orderId           String      @unique
  status            KOTStatus   @default(PLACED)
  priority          Int         @default(0)
  notes             String?
  placedAt          DateTime    @default(now())
  preparingAt       DateTime?
  readyAt           DateTime?
  servedAt          DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  createdByUserId   String?
  restaurant        Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  order             Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events            KOTTicketEvent[]

  @@index([restaurantId, status, updatedAt])
  @@map("kot_tickets")
}

model KOTTicketEvent {
  id              String      @id @default(cuid())
  restaurantId    String
  kotTicketId     String
  fromStatus      KOTStatus?
  toStatus        KOTStatus
  changedByUserId String?
  changedAt       DateTime    @default(now())
  note            String?
  restaurant      Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  kotTicket       KOTTicket   @relation(fields: [kotTicketId], references: [id], onDelete: Cascade)

  @@index([restaurantId, changedAt])
  @@map("kot_ticket_events")
}

model AnalyticsSnapshot {
  id                String               @id @default(cuid())
  restaurantId      String
  periodType        AnalyticsPeriodType
  periodStart       DateTime
  periodEnd         DateTime
  revenuePaise      Int
  orderCount        Int
  avgOrderValuePaise Int
  topItems          Json
  peakHours         Json
  metrics           Json
  insights          String
  recommendations   String
  generatedAt       DateTime             @default(now())
  restaurant        Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, periodType, periodStart, periodEnd])
  @@index([restaurantId, periodType, generatedAt])
  @@map("analytics_snapshots")
}

model PosSyncLog {
  id               String     @id @default(cuid())
  restaurantId     String
  sourceSystem     String
  eventType        String
  externalOrderId  String?
  payload          Json?
  status           String
  errorMessage     String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  restaurant       Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, sourceSystem, createdAt])
  @@map("pos_sync_logs")
}

enum UserRole {
  CUSTOMER
  ADMIN
  STAFF
  CENTRAL_ADMIN
  OWNER
  KITCHEN_STAFF
}

enum RestaurantRole {
  OWNER
  ADMIN
  STAFF
}

enum CouponType {
  PERCENT
  FIXED
}

enum PaymentProvider {
  RAZORPAY
  PAYTM
  PHONEPE
  CASH
}

enum PaymentCollectionTiming {
  BEFORE_MEAL
  AFTER_MEAL
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  SERVED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
  PARTIALLY_PAID
}

enum DeliveryStatus {
  PLACED
  CONFIRMED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum SpiceLevel {
  NONE
  MILD
  MEDIUM
  HOT
  EXTRA_HOT
}

enum InvoiceMethod {
  EMAIL
  SMS
}

enum OfferType {
  PERCENTAGE
  FIXED_AMOUNT
  BUY_X_GET_Y
  FREE_DELIVERY
}

enum OnboardingStatus {
  PENDING_APPROVAL
  APPROVED
  SUSPENDED
}

enum InventoryTransactionType {
  DEDUCTION
  RESTOCK
  ADJUSTMENT
}

enum InventoryReferenceType {
  ORDER
  PURCHASE
  MANUAL
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum LoyaltyTransactionType {
  EARN
  REDEEM
  ADJUST
}

enum KOTStatus {
  PLACED
  PREPARING
  READY
  SERVED
}

enum AnalyticsPeriodType {
  DAILY
  WEEKLY
}
